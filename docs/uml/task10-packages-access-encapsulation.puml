@startuml task10-packages-access-encapsulation
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

package "com.smartparking.model" {

    abstract class Vehicle {
        - registrationNumber : String {readOnly}
        - vehicleType : String {readOnly}
        + Vehicle(registrationNumber : String, vehicleType : String)
        + {final} getRegistrationNumber() : String
        + {final} getVehicleType() : String
        + getVehicleInfo() : String
        + {abstract} calculateFee(durationMinutes : long) : double
        # {static} computeStartedHours(durationMinutes : long) : long
        + {final} equals(obj : Object) : boolean
        + {final} hashCode() : int
        + toString() : String
    }

    class TwoWheeler {
        - hasHelmetStorage : boolean {readOnly}
        + TwoWheeler(registrationNumber : String, hasHelmetStorage : boolean)
        + hasHelmetStorage() : boolean
        + calculateFee(durationMinutes : long) : double
        + getDetailedInfo() : String
        + toString() : String
    }

    class Car {
        - seatingCapacity : int {readOnly}
        + Car(registrationNumber : String, seatingCapacity : int)
        + getSeatingCapacity() : int
        + calculateFee(durationMinutes : long) : double
        + getDetailedInfo() : String
        + toString() : String
    }

    interface Chargeable {
        + {static} STANDARD_CHARGING_RATE_PER_KWH : double = 12.0
        + {abstract} charge(energyKWh : double) : double
        + {abstract} getBatteryCapacityKWh() : double
        + {abstract} getCurrentChargeKWh() : double
        + getRemainingCapacityKWh() : double
        + getBatteryPercentage() : double
        + estimateChargingTimeMinutes(chargingPowerKW : double) : double
        + estimateChargingTimeMinutes(chargingPowerKW : double, efficiency : double) : double
        + {static} calculateChargingCost(energyKWh : double, ratePerKWh : double) : double
        + {static} validateEnergy(energyKWh : double) : void
        + {static} validatePower(powerKW : double) : void
    }

    class ElectricCar {
        - batteryCapacityKWh : double {readOnly}
        - currentBatteryLevelKWh : double
        - isCharging : boolean
        + ElectricCar(registrationNumber : String, batteryCapacityKWh : double)
        + ElectricCar(registrationNumber : String, batteryCapacityKWh : double, initialBatteryLevelKWh : double)
        - {static} validateBatteryCapacity(capacity : double) : void
        + getBatteryCapacityKWh() : double
        + getCurrentChargeKWh() : double
        + getCurrentBatteryLevelKWh() : double
        + isCharging() : boolean
        + startCharging() : void
        + stopCharging() : void
        + charge(energyKWh : double) : double
        + calculateFee(durationMinutes : long) : double
        + getDetailedInfo() : String
        + toString() : String
    }

    class ParkingTicket {
        - {static} ticketCounter : int = 1000
        - ticketId : String {readOnly}
        - vehicleRegistrationNumber : String {readOnly}
        - vehicleType : String {readOnly}
        - entryTimestamp : LocalDateTime {readOnly}
        - allocatedFloor : int {readOnly}
        - allocatedSlot : int {readOnly}
        + ParkingTicket(regNo : String, type : String, floor : int, slot : int)
        + ParkingTicket(regNo : String, type : String)
        + ParkingTicket(other : ParkingTicket)
        ~ {static} resetCounterForTesting() : void
        + getTicketId() : String
        + getVehicleRegistrationNumber() : String
        + getVehicleType() : String
        + getAllocatedFloor() : int
        + getAllocatedSlot() : int
    }

    final class ParkingTariff <<utility>> {
        + {static} TWO_WHEELER_RATE_PER_HOUR : double = 10.0
        + {static} CAR_RATE_PER_HOUR : double = 30.0
        + {static} ELECTRIC_CAR_RATE_PER_HOUR : double = 30.0
        + {static} MINUTES_PER_HOUR : int = 60
        - ParkingTariff()
        + {static} calculateStartedHours(durationMinutes : long) : long
    }

    Vehicle <|-- TwoWheeler
    Vehicle <|-- Car
    Vehicle <|-- ElectricCar
    ElectricCar ..|> Chargeable
}

package "com.smartparking.tasks" {

    class ParkingFacility {
        - slots : String[][] {readOnly}
        + ParkingFacility(slotsPerFloor : int[])
        + allocate(vehicleNo : String) : int[]
        + release(floor : int, slot : int) : boolean
    }

    class EncapsulationDemo {
        + {static} main(args : String[]) : void
    }

    EncapsulationDemo ..> Vehicle : accesses via public getters
    EncapsulationDemo ..> Car : accesses public constructor & getters
    EncapsulationDemo ..> ElectricCar : updates state via charge()
    EncapsulationDemo ..> ParkingTicket : observes encapsulation
}

package "com.smartparking.service" {
    class ParkingService <<planned>> {
        + allocateSlot(vehicle : Vehicle) : ParkingTicket
        + processExit(ticketId : String, durationMinutes : long) : double
    }

    ParkingService ..> Vehicle : operates on
    ParkingService ..> ParkingTicket : generates
}

package "com.smartparking.app" {
    class CampusParkingApp <<planned>> {
        + {static} main(args : String[]) : void
    }

    CampusParkingApp ..> ParkingService : invokes
    CampusParkingApp ..> Vehicle : configures
}

note as VisibilityLegend
  <b>PlantUML Visibility Symbols:</b>
  <b>+</b> : public (unrestricted access)
  <b>#</b> : protected (package + subclasses)
  <b>~</b> : package-private / default (same package only)
  <b>-</b> : private (declaring class only)
end note

note top of Vehicle
  <b>Access Modifiers Illustrated:</b>
  <b>-</b> private: registrationNumber, vehicleType
  <b>#</b> protected: computeStartedHours()
  <b>+</b> public: getters, equals(), calculateFee()
  <b>~</b> package-private: resetCounterForTesting()
end note

note bottom of EncapsulationDemo
  <b>Package Boundary Enforcement:</b>
  EncapsulationDemo cannot access private fields
  or package-private members in com.smartparking.model.
  All mutations pass through validated public methods.
end note

@enduml
